default_platform(:ios)

# ── App Store Connect API Key ───────────────────────────────────────────────
# iOS / macOS 양쪽 lane 에서 공통 사용. 같은 Team 의 App Manager 권한이라 둘 다 커버.
def api_key
  app_store_connect_api_key(
    key_id: "3J7D3KMFK9",
    issuer_id: "af50aef2-47fe-4b8e-9cb1-821ad1e0e236",
    key_filepath: "./fastlane/api_key.p8"
  )
end

platform :ios do

  # ── Beta: TestFlight 배포 ───────────────────────────────────────────────────
  # 빌드 번호 증가는 increment_build_number_in_xcodeproj 으로 — agvtool 은
  # 프로젝트 전체 타겟을 일괄 변경해서 macOS 까지 끌려가는 부작용이 있음.
  desc "TestFlight에 베타 빌드 배포"
  lane :beta do
    latest = latest_testflight_build_number(api_key: api_key)
    next_build = (latest + 1).to_s
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "Dozy AI",
      build_number: next_build
    )
    # App Store 는 extension 의 CFBundleVersion / CFBundleShortVersionString 이
    # 호스트 앱과 정확히 일치해야 archive export 통과. macOS 타겟까지 끌려가지 않도록
    # target 명시.
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "DozyWidgetsExtension",
      build_number: next_build
    )
    # `-allowProvisioningUpdates` 를 archive + export 양쪽 단계에 넘겨, App Group
    # 추가 / 위젯 extension 신규 App ID 같은 capability 변경 후 distribution
    # provisioning profile 까지 xcodebuild 가 자동 발급/갱신하도록 한다.
    build_app(
      scheme: "Dozy AI",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # ── Release: App Store 배포 ────────────────────────────────────────────────
  desc "App Store에 릴리즈 빌드 배포"
  lane :release do
    latest = latest_testflight_build_number(api_key: api_key)
    next_build = (latest + 1).to_s
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "Dozy AI",
      build_number: next_build
    )
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "DozyWidgetsExtension",
      build_number: next_build
    )
    build_app(
      scheme: "Dozy AI",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end

end

# ─── macOS ─────────────────────────────────────────────────────────────────

platform :mac do

  desc "macOS 로컬 컴파일 검증 (archive·서명 없이 build만)"
  lane :build do
    sh %Q(xcodebuild -project "../Dozy AI.xcodeproj" -scheme "Dozy AI (macOS)" -destination "platform=macOS" -configuration Debug build | xcbeautify || true)
  end

  desc "TestFlight(macOS)에 베타 빌드 배포"
  lane :beta do
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dozy-ai.DozyAI.macOS",
      platform: "osx"
    )
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "Dozy AI (macOS)",
      build_number: (latest + 1).to_s
    )
    build_mac_app(
      project: "Dozy AI.xcodeproj",
      scheme: "Dozy AI (macOS)",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/mac",
      clean: true
    )
    upload_to_testflight(
      api_key: api_key,
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
      app_platform: "osx",
      skip_waiting_for_build_processing: true
    )
  end

end
