default_platform(:ios)

# ── App Store Connect API Key ───────────────────────────────────────────────
# iOS / macOS 양쪽 lane 에서 공통 사용. 같은 Team 의 App Manager 권한이라 둘 다 커버.
def api_key
  app_store_connect_api_key(
    key_id: "3J7D3KMFK9",
    issuer_id: "af50aef2-47fe-4b8e-9cb1-821ad1e0e236",
    key_filepath: "./fastlane/api_key.p8"
  )
end

# ── Crashlytics dSYM 업로드 (#135) ──────────────────────────────────────────
# 빌드 단계 스크립트(Upload dSYM to Crashlytics)는 샌드박스 안에서 백그라운드로 올려 성공 여부가 남지 않고
# 실제로 누락됐다. fastlane 에서 빌드 직후 포그라운드로 한 번 더 올린다. 실패해도 배포는 막지 않는다.
def project_root
  File.expand_path("..", FastlaneCore::FastlaneFolder.path)
end

def crashlytics_upload_symbols_binary
  Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/Dozy_AI-*/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"))
     .max_by { |f| File.mtime(f) }
end

def upload_dsyms_to_crashlytics(gsp_path:, dsym_path:, platform:)
  binary = crashlytics_upload_symbols_binary
  dsym_path = File.expand_path(dsym_path, project_root) if dsym_path   # gym 은 상대 경로를 넘길 수 있다
  unless File.exist?(gsp_path) && binary && dsym_path && File.exist?(dsym_path)
    UI.important("Crashlytics dSYM 업로드 건너뜀 — plist: #{File.exist?(gsp_path)}, upload-symbols: #{!binary.nil?}, dSYM: #{dsym_path.inspect}")
    return
  end
  upload_symbols_to_crashlytics(
    dsym_path: dsym_path,
    gsp_path: gsp_path,
    binary_path: binary,
    platform: platform
  )
rescue => e
  UI.important("Crashlytics dSYM 업로드 실패 (배포는 계속): #{e.message}")
end

platform :ios do

  # ── Beta: TestFlight 배포 ───────────────────────────────────────────────────
  # 빌드 번호 증가는 increment_build_number_in_xcodeproj 으로 — agvtool 은
  # 프로젝트 전체 타겟을 일괄 변경해서 macOS 까지 끌려가는 부작용이 있음.
  desc "TestFlight에 베타 빌드 배포"
  lane :beta do
    latest = latest_testflight_build_number(api_key: api_key)
    next_build = (latest + 1).to_s
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "Dozy AI",
      build_number: next_build
    )
    # App Store 는 extension 의 CFBundleVersion / CFBundleShortVersionString 이
    # 호스트 앱과 정확히 일치해야 archive export 통과. macOS 타겟까지 끌려가지 않도록
    # target 명시.
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "DozyWidgetsExtension",
      build_number: next_build
    )
    # `-allowProvisioningUpdates` 를 archive + export 양쪽 단계에 넘겨, App Group
    # 추가 / 위젯 extension 신규 App ID 같은 capability 변경 후 distribution
    # provisioning profile 까지 xcodebuild 가 자동 발급/갱신하도록 한다.
    build_app(
      scheme: "Dozy AI",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
    upload_dsyms_to_crashlytics(
      gsp_path: File.join(project_root, "Dozy AI/GoogleService-Info.plist"),
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      platform: "ios"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # ── dSYM 수동 업로드 ───────────────────────────────────────────────────────
  # 이미 올린 빌드의 dSYM 을 Crashlytics 에 올린다. build 를 주면 그 빌드 번호의 최신 아카이브, 없으면 가장 최근 아카이브.
  #   fastlane ios upload_dsyms build:163
  desc "Xcode 아카이브의 dSYM 을 Crashlytics 에 업로드"
  lane :upload_dsyms do |options|
    archives = Dir.glob(File.expand_path("~/Library/Developer/Xcode/Archives/*/Dozy AI *.xcarchive"))
    if options[:build]
      archives = archives.select do |a|
        sh(%Q(/usr/libexec/PlistBuddy -c "Print :ApplicationProperties:CFBundleVersion" "#{a}/Info.plist"), log: false).strip == options[:build].to_s
      end
    end
    archive = archives.max_by { |a| File.mtime(a) }
    UI.user_error!("아카이브를 찾지 못함 (build: #{options[:build].inspect})") unless archive
    UI.message("아카이브: #{archive}")
    zip = File.join(project_root, "build/dsyms-#{File.basename(archive, ".xcarchive").gsub(" ", "_")}.zip")
    sh(%Q(mkdir -p "#{File.dirname(zip)}" && cd "#{archive}" && /usr/bin/ditto -c -k --keepParent dSYMs "#{zip}"))
    upload_dsyms_to_crashlytics(
      gsp_path: File.join(project_root, "Dozy AI/GoogleService-Info.plist"),
      dsym_path: zip,
      platform: "ios"
    )
  end

  # ── Release: App Store 배포 ────────────────────────────────────────────────
  desc "App Store에 릴리즈 빌드 배포"
  lane :release do
    latest = latest_testflight_build_number(api_key: api_key)
    next_build = (latest + 1).to_s
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "Dozy AI",
      build_number: next_build
    )
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "DozyWidgetsExtension",
      build_number: next_build
    )
    build_app(
      scheme: "Dozy AI",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
    upload_dsyms_to_crashlytics(
      gsp_path: File.join(project_root, "Dozy AI/GoogleService-Info.plist"),
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      platform: "ios"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end

end

# ─── macOS ─────────────────────────────────────────────────────────────────

platform :mac do

  desc "macOS 로컬 컴파일 검증 (archive·서명 없이 build만)"
  lane :build do
    sh %Q(xcodebuild -project "../Dozy AI.xcodeproj" -scheme "Dozy AI (macOS)" -destination "platform=macOS" -configuration Debug build | xcbeautify || true)
  end

  desc "TestFlight(macOS)에 베타 빌드 배포"
  lane :beta do
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dozy-ai.DozyAI.macOS",
      platform: "osx"
    )
    increment_build_number_in_xcodeproj(
      xcodeproj: "Dozy AI.xcodeproj",
      target: "Dozy AI (macOS)",
      build_number: (latest + 1).to_s
    )
    build_mac_app(
      project: "Dozy AI.xcodeproj",
      scheme: "Dozy AI (macOS)",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/mac",
      clean: true
    )
    upload_dsyms_to_crashlytics(
      gsp_path: File.join(project_root, "Dozy AI (macOS)/GoogleService-Info.plist"),
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      platform: "mac"
    )
    upload_to_testflight(
      api_key: api_key,
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
      app_platform: "osx",
      skip_waiting_for_build_processing: true
    )
  end

end
