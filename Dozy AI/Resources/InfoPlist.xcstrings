{
  "sourceLanguage" : "ko",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Calendar access prompt — shown by macOS / iOS when the app first requests full Calendar access.",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업무 일정을 분석하여 자동 일지를 생성하기 위해 캘린더 접근이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozy needs access to your calendar to analyze your schedule and generate an automatic daily log."
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
      "comment" : "Calendar access prompt (legacy / iOS pre-17 fallback).",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업무 일정을 분석하여 자동 일지를 생성하기 위해 캘린더 접근이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozy needs access to your calendar to analyze your schedule and generate an automatic daily log."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Reminders access prompt.",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료한 할 일과 남은 할 일을 분석하여 일지를 자동 생성하기 위해 미리알림 접근이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozy needs access to Reminders to analyze completed and pending tasks for your daily log."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location access prompt — used by the weather card on the Today tab.",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 탭에 현재 위치의 날씨를 표시하기 위해 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to show the weather for your current location on the Today tab."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Speech recognition prompt — used by the voice memo / voice input feature.",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성으로 메모를 받아쓰기 위해 음성 인식을 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition is used to dictate voice memos."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone prompt — used alongside speech recognition for voice memos.",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메모를 녹음하기 위해 마이크에 접근합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is used to record voice memos."
          }
        }
      }
    }
  },
  "version" : "1.0"
